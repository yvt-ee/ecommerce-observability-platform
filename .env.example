# This root file documents every environment variable used across the
# stack. docker-compose.yml sets these directly (with the right internal
# hostnames like `otel-collector` and `tempo`) so it works out of the box
# with just `docker compose up --build` -- you don't need to copy this
# file for the Docker workflow.
#
# For running services individually on your host (outside Docker), copy
# the per-service files instead:
#   backend/.env.example  -> backend/.env
#   frontend/.env.example -> frontend/.env

# --- Backend (see backend/.env.example for the authoritative list) ---
DATABASE_URL=sqlite:///./ecommerce.db
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ecommerce-backend

# --- Frontend (see frontend/.env.example) ---
VITE_API_BASE_URL=http://localhost:8000
