# Copy to .env and adjust as needed for local (non-Docker) runs.
APP_NAME=ecommerce-backend
ENVIRONMENT=local

DATABASE_URL=sqlite:///./ecommerce.db

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

OTEL_ENABLED=true
# In Docker Compose this is set to http://otel-collector:4317 instead.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ecommerce-backend
